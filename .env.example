# orchestrant — example environment. Copy to .env and fill in.
# NEVER commit real credentials. .env is gitignored.

# --- Persistence (added in the persistence phase) ---
DATABASE_URL=postgres://orchestrant:orchestrant@localhost:5432/orchestrant

# --- Adapters ---
# The mock gateway needs no credentials.
# Real adapters read their OWN keys here. Use your own sandbox/test keys only,
# e.g.:
#   STRIPE_TEST_SECRET_KEY=sk_test_xxx
